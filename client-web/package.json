{
  "name": "@alkemio/test-suite-client-web",
  "version": "0.1.0",
  "description": "Alkemio web client test suite.",
  "author": "Alkemio Holding",
  "private": false,
  "license": "EUPL-1.2",
  "main": "src/setupTests.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alkemio/test-suites.git"
  },
  "scripts": {
    "ts:watch": "tsc --noEmit --watch",
    "prebuild": "rimraf dist",
    "build": "tsc",
    "circular-dependencies": "madge --circular dist",
    "lint": "pnpm run typecheck:native && eslint src/**/*.ts{,x}",
    "lint:prod": "pnpm run typecheck:native && cross-env NODE_ENV=production eslint src/**/*.ts{,x}",
    "lint:fix": "pnpm run typecheck:native && eslint src/**/*.ts{,x} --fix",
    "typecheck:native": "tsc -p tsconfig.json --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "stop-process": "fuser 4000/tcp -k",
    "test:auth-playwright": "playwright test",
    "test:classifications": "playwright test --config=config/playwright.config.classifications.ts",
    "test:nightly": "playwright test --config=config/playwright.config.nightly.ts"
  },
  "dependencies": {
    "@alkemio/client-lib": "^0.32.0",
    "@alkemio/tests-lib": "workspace:*",
    "axios": "1.13.5",
    "graphql": "^16.6.0",
    "graphql-upload": "^17.0.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@graphql-codegen/add": "^5.0.3",
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/import-types-preset": "^3.0.0",
    "@graphql-codegen/typescript": "4.1.2",
    "@graphql-codegen/typescript-graphql-request": "^6.2.0",
    "@graphql-codegen/typescript-operations": "4.4.0",
    "@graphql-codegen/typescript-resolvers": "4.4.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.13.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.14.0",
    "graphql-request": "6.0.0",
    "prettier": "^3.4.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  },
  "_moduleAliases": {
    "@src": "./src"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
