{
  "servers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--headless", "--browser=chromium"],
      "cwd": "${workspaceFolder}/client-web" // <— adapt this to your project root
    },
    "playwright-test": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "playwright",
        "run-test-mcp-server",
        "--config=./playwright.planner.config.ts"
      ],
      "cwd": "${workspaceFolder}/client-web" // <— ensure this is the root
    },
    "postgres-alkemio": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://synapse:synapse@localhost:5432/alkemio"
      ]
    },
    "postgres-kratos": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://synapse:synapse@localhost:5432/kratos"
      ]
    },
    "postgres-synapse": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://synapse:synapse@localhost:5432/synapse"
      ]
    }
  }
}
