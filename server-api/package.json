{
  "name": "@alkemio/test-suite-server-api",
  "version": "0.3.0",
  "description": "Alkemio API quality assurance test suite.",
  "author": "Alkemio Holding",
  "private": false,
  "license": "EUPL-1.2",
  "main": "src/setupTests.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alkemio/test-suites.git"
  },
  "eslintIgnore": [
    "src/generated/graphql.tsx",
    "**/node_modules/**",
    "**/build**"
  ],
  "scripts": {
    "ts:watch": "tsc --noEmit --watch",
    "prebuild": "rimraf dist",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" tsc",
    "circular-dependencies": "madge --circular dist",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "pnpm run typecheck:native && eslint src/**/*.ts{,x}",
    "lint:prod": "pnpm run typecheck:native && cross-env NODE_ENV=production eslint src/**/*.ts{,x}",
    "lint:fix": "pnpm run typecheck:native && eslint src/**/*.ts{,x} --fix",
    "typecheck:native": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" tsc -p tsconfig.json --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "stop-process": "fuser 4000/tcp -k",
    "test:watch": "vitest",
    "test:debug": "vitest run --inspect-brk --fileParallelism=false",
    "test:nightly": "vitest run --project nightly --fileParallelism=false",
    "test:nightly:ui": "vitest --project nightly --fileParallelism=false --ui",
    "test:search:ui": "vitest --project search --fileParallelism=false --ui",
    "test:communications": "vitest run --project communication --fileParallelism=false",
    "test:notifications:ui": "vitest --project notifications --fileParallelism=false --ui",
    "test:notifications:callouts": "vitest run --project notifications-callouts --fileParallelism=false",
    "test:notifications:messaging": "vitest run --project notifications-messaging --fileParallelism=false",
    "test:notifications:community": "vitest run --project notifications-community --fileParallelism=false",
    "test:lifecycle": "vitest run --project lifecycle --fileParallelism=false",
    "test:account": "vitest run --project account --fileParallelism=false",
    "test:callouts": "vitest run --project callouts --fileParallelism=false",
    "test:integration-parallel": "vitest run --project integration --poolOptions.threads.maxThreads=4",
    "test:organization": "vitest run --project organization --poolOptions.threads.maxThreads=6",
    "test:entitlements": "vitest run --project entitlements --fileParallelism=false",
    "test:journey": "vitest run --project journey --fileParallelism=false",
    "test:activity-logs": "vitest run --project activity-logs --fileParallelism=false",
    "test:contributormanagement": "vitest run --project contributor-management --fileParallelism=false",
    "test:integration": "vitest run --project integration --fileParallelism=false",
    "test:storage": "vitest run --project storage --fileParallelism=false",
    "test:preferences": "vitest run --project preferences --poolOptions.threads.maxThreads=3",
    "test:pagination": "vitest run --project pagination --fileParallelism=false",
    "test:roleset": "vitest run --project roleset --fileParallelism=false",
    "test:subscriptions": "vitest run --project subscriptions --fileParallelism=false",
    "test:templates": "vitest run --project templates --fileParallelism=false",
    "test:innovation": "vitest run --project innovation --fileParallelism=false",
    "test:documents": "vitest run --project documents --fileParallelism=false",
    "test:configuration": "vitest run --project configuration --fileParallelism=false",
    "test:push-notifications": "vitest run --project push-notifications --fileParallelism=false",
    "test:graphql-guard:ui": "vitest --project graphql-guard --fileParallelism=false --ui",
    "test:platform-roles": "vitest run --project platform-roles --fileParallelism=false",
    "test:platform-roles:canonical": "vitest run --project platform-roles-canonical --fileParallelism=false",
    "innovation-pack-with-templates": "tsx ./src/functional-api/innovation-pack/innovation-pack-with-templates.ts",
    "validate-scenario-setup": "tsx ./src/scripts/validate-scenario-setup.ts"
  },
  "dependencies": {
    "@alkemio/client-lib": "^0.36.0",
    "@alkemio/tests-lib": "workspace:*",
    "axios": "1.13.5",
    "graphql": "^16.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/add": "^5.0.3",
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/import-types-preset": "^3.0.0",
    "@graphql-codegen/typescript": "4.1.2",
    "@graphql-codegen/typescript-graphql-request": "^6.2.0",
    "@graphql-codegen/typescript-operations": "4.4.0",
    "@graphql-codegen/typescript-resolvers": "4.4.1",
    "@types/node": "^20.13.1",
    "@vitest/ui": "^4.0.18",
    "cross-env": "^7.0.3",
    "eslint": "^9.38.0",
    "globals": "^15.14.0",
    "graphql-request": "6.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript-eslint": "^8.21.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}