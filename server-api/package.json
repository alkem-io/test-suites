{
  "name": "@alkemio/test-suite-server-api",
  "version": "0.3.0",
  "description": "Alkemio API quality assurance test suite.",
  "author": "Alkemio Holding",
  "private": false,
  "license": "EUPL-1.2",
  "main": "src/setupTests.ts",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alkemio/test-suites.git"
  },
  "eslintIgnore": [
    "src/generated/graphql.tsx",
    "**/node_modules/**",
    "**/build**"
  ],
  "scripts": {
    "ts:watch": "tsc --noEmit --watch",
    "prebuild": "rimraf dist",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" tsc",
    "circular-dependencies": "madge --circular dist",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" tsc --noEmit && eslint src/**/*.ts{,x}",
    "lint:prod": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" tsc --noEmit && cross-env NODE_ENV=production eslint src/**/*.ts{,x}",
    "lint:fix": "cross-env NODE_OPTIONS=\"--max-old-space-size=8192\" tsc --noEmit && eslint src/**/*.ts{,x} --fix",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "stop-process": "fuser 4000/tcp -k",
    "test:watch": "vitest",
    "test:debug": "node --inspect-brk node_modules/vitest/vitest.mjs run --fileParallelism=false",
    "test:nightly": "vitest run --project nightly --maxWorkers=1",
    "test:communications": "vitest run --project communication --forceExit --fileParallelism=false",
    "test:notifications": "vitest run --project notifications --forceExit --fileParallelism=false",
    "test:notifications:callouts": "vitest run --project notifications-callouts --forceExit --fileParallelism=false",
    "test:notifications:messaging": "vitest run --project notifications-messaging --forceExit --fileParallelism=false",
    "test:notifications:community": "vitest run --project notifications-community --forceExit --fileParallelism=false",
    "test:lifecycle": "vitest run --project lifecycle --forceExit --fileParallelism=false",
    "test:account": "vitest run --project account --forceExit --fileParallelism=false",
    "test:callouts": "vitest run --project callouts --forceExit --fileParallelism=false",
    "test:integration-parallel": "vitest run --project integration --forceExit --maxWorkers=4",
    "test:organization": "vitest run --project organization --forceExit --maxWorkers=6",
    "test:search": "vitest run --project search --forceExit --maxWorkers=6",
    "test:communication": "vitest run --project communication --forceExit --fileParallelism=false",
    "test:entitlements": "vitest run --project entitlements --forceExit --fileParallelism=false",
    "test:journey": "vitest run --project journey --forceExit --fileParallelism=false",
    "test:activity-logs": "vitest run --project activity-logs --forceExit --fileParallelism=false",
    "test:contributormanagement": "vitest run --project contributor-management --forceExit --fileParallelism=false",
    "test:integration": "vitest run --project integration --forceExit --maxWorkers=1",
    "test:storage": "vitest run --project storage --forceExit --maxWorkers=1",
    "test:preferences": "vitest run --project preferences --forceExit --maxWorkers=3",
    "test:pagination": "vitest run --project pagination --forceExit --maxWorkers=1",
    "test:roleset": "vitest run --project roleset --forceExit --fileParallelism=false",
    "test:subscriptions": "vitest run --project subscriptions --forceExit --maxWorkers=1",
    "test:templates": "vitest run --project templates --forceExit --maxWorkers=1",
    "test:innovation": "vitest run --project innovation --forceExit --maxWorkers=1",
    "test:documents": "vitest run --project documents --forceExit --maxWorkers=1",
    "test:configuration": "vitest run --project configuration --forceExit --maxWorkers=1",
    "innovation-pack-with-templates": "tsx ./src/functional-api/innovation-pack/innovation-pack-with-templates.ts",
    "validate-scenario-setup": "tsx ./src/scripts/validate-scenario-setup.ts"
  },
  "dependencies": {
    "@alkemio/client-lib": "^0.36.0",
    "@alkemio/tests-lib": "workspace:*",
    "@ory/kratos-client": "^0.11.1",
    "axios": "1.13.5",
    "graphql": "^16.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/add": "^5.0.3",
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/import-types-preset": "^3.0.0",
    "@graphql-codegen/typescript": "4.1.2",
    "@graphql-codegen/typescript-graphql-request": "^6.2.0",
    "@graphql-codegen/typescript-operations": "4.4.0",
    "@graphql-codegen/typescript-resolvers": "4.4.1",
    "@types/node": "^20.13.1",
    "@vitest/ui": "^4.0.18",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "globals": "^15.14.0",
    "graphql-request": "6.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
