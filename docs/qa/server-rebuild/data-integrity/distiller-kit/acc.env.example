# acc.env.example: copy to acc.env (never committed) and fill in. Read by 90-acc-switch.sh and 91-acc-timed-run.sh.
# The values come from the deployment manifests of the environment (infrastructure-operations), not from this repository.
ACC_CONTEXT=            # kubectl context of the acceptance cluster. A name that contains "prod" is refused.
ACC_NAMESPACE=default   # namespace of the platform workloads
ACC_LIVE_DB=alkemio     # name of the live platform database
ACC_WRITERS=""          # space-separated deployments that connect to the platform database. The connection pooler goes LAST.
ACC_CRONS=""            # space-separated scheduled jobs to suspend during the freeze
ACC_RABBIT_POD=         # pod of the queue service, to read the length of the authorization reset queue
ACC_PGUSER=             # database user for read-only guard runs through 93-psql-live-acc.sh
ACC_SERVER_DEPLOY=        # deployment of the platform server (its image tag is read, its rollout is awaited)
ACC_RESET_WORKER_DEPLOY=  # deployment of the authorization reset worker (its replica count is shown)
