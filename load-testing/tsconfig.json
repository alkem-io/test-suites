{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "paths": {
      "@alkemio/tests-lib": ["../lib/src/index.ts"],
      "@alkemio/tests-lib/*": ["../lib/src/*"],
      "@server-api/*": ["../server-api/src/*"],
    }
  },
  "include": ["**/*.ts"]
}
